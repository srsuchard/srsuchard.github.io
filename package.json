{
  "name": "srsuchard-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm og && next build && node scripts/csp-meta.mjs out",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit",
    "test:build": "pnpm build && vitest run tests/build",
    "preview": "node scripts/serve-out.mjs --port 3200",
    "test:e2e": "pnpm build && playwright test",
    "media": "tsx scripts/optimize-media.ts",
    "og": "tsx scripts/generate-og.tsx",
    "verify:links": "tsx scripts/verify-links.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
